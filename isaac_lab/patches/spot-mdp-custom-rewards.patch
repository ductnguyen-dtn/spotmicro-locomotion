+def base_pitch_penalty(env: ManagerBasedRLEnv, asset_cfg: SceneEntityCfg) -> torch.Tensor:
+    """Penalize fore-aft torso lean (pitch), isolated from roll.
+
+    The x-component of projected gravity in the body frame is the forward/backward
+    tilt; it is zero when the torso is level and grows as the robot pitches nose-down
+    or nose-up. Because the hips are rigid on the torso, this equals the front-vs-rear
+    hip-height difference scaled by body length, a direct "front-rear leveling" term.
+    Unlike :func:`base_orientation_penalty`, it leaves roll unpenalized.
+    """
+    asset: RigidObject = env.scene[asset_cfg.name]
+    return torch.abs(wp.to_torch(asset.data.projected_gravity_b)[:, 0])
+

+def foot_duty_balance_penalty(
+    env: ManagerBasedRLEnv,
+    sensor_cfg: SceneEntityCfg,
+    asset_cfg: SceneEntityCfg,
+    max_time: float,
+    velocity_threshold: float,
+) -> torch.Tensor:
+    """Penalize per-foot imbalance between stance and swing duration (drives duty toward 0.5).
+
+    For each foot, ``|last_contact_time - last_air_time|`` is zero only when it spends equal
+    time on the ground and in the air, duty factor 0.5, the even rhythm of a symmetric trot.
+    It fires when a foot acts as constant support (long stance, short swing) or the reverse,
+    which pair-difference symmetry terms miss. Durations are clipped at ``max_time``; the
+    penalty is zero below ``velocity_threshold`` (standing = all feet down is not penalized).
+    """
+    contact_sensor: ContactSensor = env.scene.sensors[sensor_cfg.name]
+    asset: Articulation = env.scene[asset_cfg.name]
+    stance = torch.clip(wp.to_torch(contact_sensor.data.last_contact_time)[:, sensor_cfg.body_ids], max=max_time)
+    swing = torch.clip(wp.to_torch(contact_sensor.data.last_air_time)[:, sensor_cfg.body_ids], max=max_time)
+    penalty = torch.sum(torch.abs(stance - swing), dim=1)
+    cmd = torch.linalg.norm(env.command_manager.get_command("base_velocity"), dim=1)
+    body_vel = torch.linalg.norm(wp.to_torch(asset.data.root_lin_vel_b)[:, :2], dim=1)
+    return torch.where(torch.logical_or(cmd > 0.0, body_vel > velocity_threshold), penalty, 0.0)
+
+
+def foot_stride_reward(
+    env: ManagerBasedRLEnv,
+    asset_cfg: SceneEntityCfg,
+    velocity_threshold: float,
+) -> torch.Tensor:
+    """Reward fore-aft foot excursion relative to the base (stride length / propulsion).
+
+    For each foot, the fore-aft (base-frame x) component of its velocity *relative to the
+    base* is the rate at which the foot protracts during swing and recedes during stance
+    along the body. Its magnitude integrated over a stride equals stride length, so
+    rewarding it pressures every leg to swing its hip fore-aft rather than pump vertically
+    in place. Measuring relative to the base makes passive body translation cancel: a foot
+    planted while the torso coasts forward earns nothing. Discrimination is partial, not
+    absolute, a knee-pumping leg still produces some fore-aft foot velocity, so the parked
+    HR leg reads lowest but not zero (measured ~0.40 vs ~0.55-0.60 m/s for healthy legs).
+    The reward is summed over feet, so the lowest leg carries the steepest marginal
+    gradient; it is zeroed below ``velocity_threshold`` so standing is not rewarded.
+    """
+    asset: Articulation = env.scene[asset_cfg.name]
+    num_feet = len(asset_cfg.body_ids)
+    foot_vel_w = wp.to_torch(asset.data.body_lin_vel_w)[:, asset_cfg.body_ids, :]  # (N, F, 3)
+    base_vel_w = wp.to_torch(asset.data.root_lin_vel_w)[:, None, :]  # (N, 1, 3)
+    rel_vel_w = foot_vel_w - base_vel_w  # foot velocity relative to base, world frame
+    # rotate into the base frame to isolate the fore-aft (x) component
+    quat = wp.to_torch(asset.data.root_quat_w)  # (N, 4)
+    quat_exp = quat[:, None, :].expand(-1, num_feet, -1).reshape(-1, 4)
+    rel_vel_b = quat_apply_inverse(quat_exp, rel_vel_w.reshape(-1, 3)).reshape(-1, num_feet, 3)
+    fore_aft_speed = torch.abs(rel_vel_b[:, :, 0])  # (N, F)
+    reward = torch.sum(fore_aft_speed, dim=1)  # (N,)
+    cmd = torch.linalg.norm(env.command_manager.get_command("base_velocity"), dim=1)
+    body_vel = torch.linalg.norm(wp.to_torch(asset.data.root_lin_vel_b)[:, :2], dim=1)
+    return torch.where(torch.logical_or(cmd > 0.0, body_vel > velocity_threshold), reward, 0.0)
+
+
+class FootStrideReward(ManagerTermBase):
+    """Reward per-foot stride LENGTH (jitter-proof), peak-to-peak fore-aft foot
+    displacement relative to the base over a short window.
+
+    Supersedes :func:`foot_stride_reward`'s instantaneous ``|velocity|`` form, which the
+    policy farmed by shaking (high velocity, ~zero net displacement -> the source of the
+    right-gait shake). Stride length is the peak-to-peak of each foot's base-frame fore-aft
+    position over ``window`` seconds: a real stride has large peak-to-peak, jitter has tiny
+    peak-to-peak, so shaking earns nothing while genuine hip swing is still rewarded.
+    Summed over feet, velocity-gated. The window buffer is reset per-env on episode reset
+    (seeded to the current position) so a reset teleport never inflates the peak-to-peak.
+    """
+
+    def __init__(self, cfg: RewardTermCfg, env: ManagerBasedRLEnv):
+        super().__init__(cfg, env)
+        self.asset: Articulation = env.scene[cfg.params["asset_cfg"].name]
+        self.foot_ids, _ = self.asset.find_bodies(cfg.params["foot_names"], preserve_order=True)
+        self.nf = len(self.foot_ids)
+        self.velocity_threshold: float = cfg.params["velocity_threshold"]
+        self.n_window = max(2, int(round(cfg.params["window"] / env.step_dt)))
+        self.buf = torch.zeros(env.num_envs, self.n_window, self.nf, device=env.device)
+        self.ptr = 0
+
+    def _foot_fore_aft(self) -> torch.Tensor:
+        """Base-frame fore-aft (x) position of each tracked foot, shape (num_envs, nf)."""
+        root_pos = wp.to_torch(self.asset.data.root_pos_w)[:, None, :]
+        quat = wp.to_torch(self.asset.data.root_quat_w)
+        foot_pos = wp.to_torch(self.asset.data.body_pos_w)[:, self.foot_ids, :]
+        rel = foot_pos - root_pos
+        q = quat[:, None, :].expand(-1, self.nf, -1).reshape(-1, 4)
+        rel_b = quat_apply_inverse(q, rel.reshape(-1, 3)).reshape(-1, self.nf, 3)
+        return rel_b[:, :, 0]
+
+    def reset(self, env_ids: torch.Tensor | None = None) -> None:
+        x = self._foot_fore_aft()
+        if env_ids is None:
+            self.buf[:] = x.unsqueeze(1)
+        else:
+            self.buf[env_ids] = x[env_ids].unsqueeze(1)
+
+    def __call__(
+        self,
+        env: ManagerBasedRLEnv,
+        asset_cfg: SceneEntityCfg,
+        foot_names: list[str],
+        velocity_threshold: float,
+        window: float,
+    ) -> torch.Tensor:
+        self.buf[:, self.ptr, :] = self._foot_fore_aft()
+        self.ptr = (self.ptr + 1) % self.n_window
+        stride = self.buf.max(dim=1).values - self.buf.min(dim=1).values  # (num_envs, nf)
+        reward = torch.sum(stride, dim=1)
+        cmd = torch.linalg.norm(env.command_manager.get_command("base_velocity"), dim=1)
+        body_vel = torch.linalg.norm(wp.to_torch(self.asset.data.root_lin_vel_b)[:, :2], dim=1)
+        return torch.where(torch.logical_or(cmd > 0.0, body_vel > velocity_threshold), reward, 0.0)
+
+
+def foot_lateral_symmetry_penalty(
+    env: ManagerBasedRLEnv,
+    asset_cfg: SceneEntityCfg,
+    left_foot_names: list[str],
+    right_foot_names: list[str],
+    velocity_threshold: float,
+) -> torch.Tensor:
+    """Penalize left/right stance-width asymmetry (hip-abduction symmetry, measured at the foot).
+
+    For each mirror pair (``left_foot_names[i]`` with ``right_foot_names[i]``, e.g. FL↔FR and
+    HL↔HR) the feet are located in the BASE frame and their lateral (Y) offsets are compared.
+    A symmetric stance is mirrored about the centerline, so ``Y_left = -Y_right`` and their sum
+    is zero; ``|Y_left + Y_right|`` fires when one side plants wider than the other. Measured at

+class FootContactSymmetryPenalty(ManagerTermBase):
+    """Penalize asymmetric air time between left (FL, HL) and right (FR, HR) foot pairs.
+
+    Fires when one side steps significantly more than the other, directly targeting
+    left/right propulsion imbalance. Returns zero during standing (below velocity_threshold).
+    """
+
+    def __init__(self, cfg: RewardTermCfg, env: ManagerBasedRLEnv):
+        super().__init__(cfg, env)
+        self.velocity_threshold: float = cfg.params["velocity_threshold"]
+        self.contact_sensor: ContactSensor = env.scene.sensors[cfg.params["sensor_cfg"].name]
+        self.asset: Articulation = env.scene[cfg.params["asset_cfg"].name]
+        self.left_ids = self.contact_sensor.find_sensors(cfg.params["left_foot_names"])[0]
+        self.right_ids = self.contact_sensor.find_sensors(cfg.params["right_foot_names"])[0]
+
+    def __call__(
+        self,
+        env: ManagerBasedRLEnv,
+        velocity_threshold: float,
+        left_foot_names: list[str],
+        right_foot_names: list[str],
+        asset_cfg: SceneEntityCfg,
+        sensor_cfg: SceneEntityCfg,
+    ) -> torch.Tensor:
+        air_time = wp.to_torch(self.contact_sensor.data.current_air_time)
+        left_air = air_time[:, self.left_ids].sum(dim=1)
+        right_air = air_time[:, self.right_ids].sum(dim=1)
+        penalty = torch.abs(left_air - right_air)
+        cmd = torch.linalg.norm(env.command_manager.get_command("base_velocity"), dim=1)
+        body_vel = torch.linalg.norm(wp.to_torch(self.asset.data.root_lin_vel_b)[:, :2], dim=1)
+        return torch.where(
+            torch.logical_or(cmd > 0.0, body_vel > self.velocity_threshold), penalty, 0.0
+        )
+
+
+class ContactTimeSymmetryPenalty(ManagerTermBase):
+    """Penalize asymmetric ground-contact time between two configured foot groups.
+
+    Uses ``last_contact_time``, the duration of each foot's most recent COMPLETED stance , 
+    which is phase-robust: a symmetric trot scores ~0 regardless of which group is currently
+    up. (Using the instantaneous ``current_contact_time`` instead makes anti-phase diagonal
+    groups differ by construction, so the penalty would measure the trot rhythm, not the
+    asymmetry, and could never reach zero.) Durations are clipped per foot so a long stance
+    cannot make the penalty explode. Zero below velocity_threshold.
+    """
+
+    def __init__(self, cfg: RewardTermCfg, env: ManagerBasedRLEnv):
+        super().__init__(cfg, env)
+        self.velocity_threshold: float = cfg.params["velocity_threshold"]
+        self.max_contact_time: float = cfg.params["max_contact_time"]
+        self.contact_sensor: ContactSensor = env.scene.sensors[cfg.params["sensor_cfg"].name]
+        self.asset: Articulation = env.scene[cfg.params["asset_cfg"].name]
+        self.left_ids = self.contact_sensor.find_sensors(cfg.params["left_foot_names"])[0]
+        self.right_ids = self.contact_sensor.find_sensors(cfg.params["right_foot_names"])[0]
+
+    def __call__(
+        self,
+        env: ManagerBasedRLEnv,
+        velocity_threshold: float,
+        max_contact_time: float,
+        left_foot_names: list[str],
+        right_foot_names: list[str],
+        asset_cfg: SceneEntityCfg,
+        sensor_cfg: SceneEntityCfg,
+    ) -> torch.Tensor:
+        contact_time = torch.clip(
+            wp.to_torch(self.contact_sensor.data.last_contact_time), max=self.max_contact_time
+        )
+        left_contact = contact_time[:, self.left_ids].sum(dim=1)
+        right_contact = contact_time[:, self.right_ids].sum(dim=1)
+        penalty = torch.abs(left_contact - right_contact)
+        cmd = torch.linalg.norm(env.command_manager.get_command("base_velocity"), dim=1)
+        body_vel = torch.linalg.norm(wp.to_torch(self.asset.data.root_lin_vel_b)[:, :2], dim=1)
+        return torch.where(
+            torch.logical_or(cmd > 0.0, body_vel > self.velocity_threshold), penalty, 0.0
+        )
+
+
+class JointMirrorSymmetryPenalty(ManagerTermBase):
+    """Penalize left/right asymmetry in time-averaged joint angles.
+
+    Compares a running average of each left-leg joint against its mirrored right-leg
+    counterpart (e.g. FL_HipY vs FR_HipY). The averaging window washes out trot phase , 
+    left and right legs are 180 deg out of phase, so instantaneous angle matching would
+    punish correct trotting. An evenly mirrored gait pays zero; a side that habitually
+    operates more bent or less swung pays every step.
+    """
+
+    def __init__(self, cfg: RewardTermCfg, env: ManagerBasedRLEnv):
+        super().__init__(cfg, env)
+        self.asset: Articulation = env.scene[cfg.params["asset_cfg"].name]
+        self.left_ids = self.asset.find_joints(cfg.params["left_joint_names"], preserve_order=True)[0]
+        self.right_ids = self.asset.find_joints(cfg.params["right_joint_names"], preserve_order=True)[0]
+        self.alpha: float = env.step_dt / cfg.params["avg_window"]
+        default_pos = wp.to_torch(self.asset.data.default_joint_pos)
+        self._left_avg = default_pos[:, self.left_ids].clone()
+        self._right_avg = default_pos[:, self.right_ids].clone()
+        # amplitude = running average of |q - mean|; a lazy joint and an active one
+        # can share a mean, so means alone are blind to one side moving less.
+        self._left_amp = torch.zeros_like(self._left_avg)
+        self._right_amp = torch.zeros_like(self._right_avg)
+
+    def reset(self, env_ids=None):
+        if env_ids is None:
+            env_ids = slice(None)
+        default_pos = wp.to_torch(self.asset.data.default_joint_pos)
+        self._left_avg[env_ids] = default_pos[env_ids][:, self.left_ids]
+        self._right_avg[env_ids] = default_pos[env_ids][:, self.right_ids]
+        self._left_amp[env_ids] = 0.0
+        self._right_amp[env_ids] = 0.0
+
+    def __call__(
+        self,
+        env: ManagerBasedRLEnv,
+        avg_window: float,
+        left_joint_names: list[str],
+        right_joint_names: list[str],
+        asset_cfg: SceneEntityCfg,
+    ) -> torch.Tensor:
+        joint_pos = wp.to_torch(self.asset.data.joint_pos)
+        left_pos = joint_pos[:, self.left_ids]
+        right_pos = joint_pos[:, self.right_ids]
+        self._left_avg += self.alpha * (left_pos - self._left_avg)
+        self._right_avg += self.alpha * (right_pos - self._right_avg)
+        self._left_amp += self.alpha * (torch.abs(left_pos - self._left_avg) - self._left_amp)
+        self._right_amp += self.alpha * (torch.abs(right_pos - self._right_avg) - self._right_amp)
+        mean_gap = torch.sum(torch.abs(self._left_avg - self._right_avg), dim=1)
+        amp_gap = torch.sum(torch.abs(self._left_amp - self._right_amp), dim=1)
+        return mean_gap + amp_gap
+
+
+class JointDiagonalSyncPenalty(ManagerTermBase):
+    """Penalize instantaneous waveform mismatch between diagonal partner joints.
+
+    In a trot the diagonal pairs (FL+HR, FR+HL) move in phase, so their joint angles can
+    be compared at every timestep, unlike mirror pairs, which are 180 deg out of phase.
+    Angles are mean-centered (running average) before comparison so the natural front/rear
+    posture offset is not penalized, only the motion waveforms being out of sync.
+    """
+
+    def __init__(self, cfg: RewardTermCfg, env: ManagerBasedRLEnv):
+        super().__init__(cfg, env)
+        self.asset: Articulation = env.scene[cfg.params["asset_cfg"].name]
+        self.a_ids = self.asset.find_joints(cfg.params["pair_a_joint_names"], preserve_order=True)[0]
+        self.b_ids = self.asset.find_joints(cfg.params["pair_b_joint_names"], preserve_order=True)[0]
+        self.alpha: float = env.step_dt / cfg.params["avg_window"]
+        default_pos = wp.to_torch(self.asset.data.default_joint_pos)
+        self._a_avg = default_pos[:, self.a_ids].clone()
+        self._b_avg = default_pos[:, self.b_ids].clone()
+
+    def reset(self, env_ids=None):
+        if env_ids is None:
+            env_ids = slice(None)
+        default_pos = wp.to_torch(self.asset.data.default_joint_pos)
+        self._a_avg[env_ids] = default_pos[env_ids][:, self.a_ids]
+        self._b_avg[env_ids] = default_pos[env_ids][:, self.b_ids]
+
+    def __call__(
+        self,
+        env: ManagerBasedRLEnv,
+        avg_window: float,
+        pair_a_joint_names: list[str],
+        pair_b_joint_names: list[str],
+        asset_cfg: SceneEntityCfg,
+    ) -> torch.Tensor:
+        joint_pos = wp.to_torch(self.asset.data.joint_pos)
+        a_pos = joint_pos[:, self.a_ids]
+        b_pos = joint_pos[:, self.b_ids]
+        self._a_avg += self.alpha * (a_pos - self._a_avg)
+        self._b_avg += self.alpha * (b_pos - self._b_avg)
+        a_centered = a_pos - self._a_avg
+        b_centered = b_pos - self._b_avg
+        return torch.sum(torch.abs(a_centered - b_centered), dim=1)
+
+

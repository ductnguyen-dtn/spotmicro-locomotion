+def knee_hyperflexion_penalty(
+    env: ManagerBasedRLEnv, asset_cfg: SceneEntityCfg, max_angle: float
+) -> torch.Tensor:
+    """Penalize knee joints for exceeding max_angle (too bent / hyperflexed).
+
+    Linear penalty on the excess above max_angle, summed across all matched joints.
+    Pass asset_cfg with joint_names=".*Knee.*" to target all four knees.
+    """
+    asset: Articulation = env.scene[asset_cfg.name]
+    knee_pos = wp.to_torch(asset.data.joint_pos)[:, asset_cfg.joint_ids]
+    return torch.sum(torch.clamp(knee_pos - max_angle, min=0.0), dim=1)
+
+
+def base_height_lock_penalty(
+    env: ManagerBasedRLEnv, asset_cfg: SceneEntityCfg, target_height: float
+) -> torch.Tensor:
+    """Penalize absolute deviation of body height from target_height (two-sided).
+
+    Linear (not squared) so the gradient stays strong even at small deficits.
+    """
+    asset: Articulation = env.scene[asset_cfg.name]
+    h = wp.to_torch(asset.data.root_pos_w)[:, 2]
+    return torch.abs(h - target_height)
+
+
+def base_height_floor_penalty(
+    env: ManagerBasedRLEnv, asset_cfg: SceneEntityCfg, min_height: float
+) -> torch.Tensor:
+    """Penalize only when body height drops below min_height; zero above it.
+
+    Unlike base_height_penalty, there is no fixed target to hack toward, the robot is
+    free to stand at any height above min_height with no additional penalty.
+    """
+    asset: Articulation = env.scene[asset_cfg.name]
+    h = wp.to_torch(asset.data.root_pos_w)[:, 2]
+    # Linear (not squared) so the gradient is strong even at small deficits.
+    # Squared penalty near a 2–3 cm deficit gives ~0.001 per step, negligible vs gait rewards.
+    return torch.clamp(min_height - h, min=0.0)
+

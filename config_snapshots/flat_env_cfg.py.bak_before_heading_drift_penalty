def rear_foot_joint_symmetry(env, asset_cfg: SceneEntityCfg = SceneEntityCfg("robot")) -> torch.Tensor:
    """Penalize rear-left foot joint position bias relative to rear-right foot."""
    asset = env.scene[asset_cfg.name]

    joint_names = list(asset.data.joint_names)

    rear_left_foot_id = joint_names.index("rear_left_foot")
    rear_right_foot_id = joint_names.index("rear_right_foot")

    joint_pos = asset.data.joint_pos
    if not isinstance(joint_pos, torch.Tensor):
        joint_pos = wp.to_torch(joint_pos)

    rear_left_foot_pos = joint_pos[:, rear_left_foot_id]
    rear_right_foot_pos = joint_pos[:, rear_right_foot_id]

    return torch.square(rear_left_foot_pos - rear_right_foot_pos)


def rear_left_foot_clearance_penalty(
    env,
    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
    target_height: float = 0.122,
) -> torch.Tensor:
    """Penalize rear-left foot link being below a world-frame clearance target.

    Intended to reduce visible rear-left dragging on flat terrain.
    """
    asset = env.scene[asset_cfg.name]

    body_names = list(asset.data.body_names)
    rear_left_foot_id = body_names.index("rear_left_foot_link")

    body_pos_w = asset.data.body_pos_w
    if not isinstance(body_pos_w, torch.Tensor):
        body_pos_w = wp.to_torch(body_pos_w)

    rear_left_foot_z = body_pos_w[:, rear_left_foot_id, 2]

    return torch.square(torch.clamp(target_height - rear_left_foot_z, min=0.0))


def lateral_velocity_penalty(
    env,
    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
) -> torch.Tensor:
    """Penalize sideways body velocity.

    Intended to reduce right/left drift when heading stays forward.
    """
    asset = env.scene[asset_cfg.name]

    root_lin_vel_b = asset.data.root_lin_vel_b
    if not isinstance(root_lin_vel_b, torch.Tensor):
        root_lin_vel_b = wp.to_torch(root_lin_vel_b)

    lateral_vel_y = root_lin_vel_b[:, 1]

    return torch.square(lateral_vel_y)

def path_two_point_tracking_penalty(
    env,
    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
    half_length: float = 0.20,
) -> torch.Tensor:
    """Penalize sideways drift and body yaw away from the intended +X walking line.

    We create two virtual points on the robot centerline:
    - one point in front of the base
    - one point behind the base

    If both points stay close to the starting Y line, the robot is both:
    1. staying on the path
    2. keeping its body aligned with +X
    """
    asset = env.scene[asset_cfg.name]

    root_pos_w = asset.data.root_pos_w
    root_quat_w = asset.data.root_quat_w

    if not isinstance(root_pos_w, torch.Tensor):
        root_pos_w = wp.to_torch(root_pos_w)

    if not isinstance(root_quat_w, torch.Tensor):
        root_quat_w = wp.to_torch(root_quat_w)

    current_y = root_pos_w[:, 1]

    # Isaac Lab quaternions are usually stored as (w, x, y, z).
    qw = root_quat_w[:, 0]
    qx = root_quat_w[:, 1]
    qy = root_quat_w[:, 2]
    qz = root_quat_w[:, 3]

    # Y component of the robot's local +X axis in world frame.
    # If the robot points perfectly along world +X, this value is 0.
    forward_y = 2.0 * (qx * qy + qw * qz)

    front_y = current_y + half_length * forward_y
    rear_y = current_y - half_length * forward_y

    if (
        not hasattr(env, "_spot_path_start_y")
        or env._spot_path_start_y.shape[0] != current_y.shape[0]
        or env._spot_path_start_y.device != current_y.device
    ):
        env._spot_path_start_y = current_y.detach().clone()

    # Refresh starting Y for environments that just reset.
    reset_mask = env.episode_length_buf <= 1
    env._spot_path_start_y[reset_mask] = current_y.detach()[reset_mask]

    front_error = front_y - env._spot_path_start_y
    rear_error = rear_y - env._spot_path_start_y

    return 0.5 * (torch.square(front_error) + torch.square(rear_error))

def rear_leg_joint_symmetry(
    env,
    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
) -> torch.Tensor:
    """Penalize rear-left/rear-right leg joint compensation."""
    asset = env.scene[asset_cfg.name]

    joint_names = list(asset.data.joint_names)

    rear_left_leg_id = joint_names.index("rear_left_leg")
    rear_right_leg_id = joint_names.index("rear_right_leg")

    joint_pos = asset.data.joint_pos
    if not isinstance(joint_pos, torch.Tensor):
        joint_pos = wp.to_torch(joint_pos)

    rear_left_leg_pos = joint_pos[:, rear_left_leg_id]
    rear_right_leg_pos = joint_pos[:, rear_right_leg_id]

    return torch.square(rear_left_leg_pos - rear_right_leg_pos)


def rear_foot_xz_velocity_symmetry_penalty(
    env,
    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
) -> torch.Tensor:
    """Penalize unequal rear-left vs rear-right foot X/Z motion activity.

    X = forward/backward stride activity.
    Z = vertical lift activity.
    """

    asset = env.scene[asset_cfg.name]
    body_names = list(asset.data.body_names)

    rear_left_name = "rear_left_foot_link"
    rear_right_name = "rear_right_foot_link"

    if rear_left_name not in body_names:
        raise RuntimeError(
            f"{rear_left_name} not found in body names: {body_names}"
        )

    if rear_right_name not in body_names:
        raise RuntimeError(
            f"{rear_right_name} not found in body names: {body_names}"
        )

    rear_left_id = body_names.index(rear_left_name)
    rear_right_id = body_names.index(rear_right_name)

    body_lin_vel_w_data = asset.data.body_lin_vel_w
    root_quat_w_data = asset.data.root_quat_w

    body_lin_vel_w = (
        body_lin_vel_w_data
        if isinstance(body_lin_vel_w_data, torch.Tensor)
        else wp.to_torch(body_lin_vel_w_data)
    )

    root_quat_w = (
        root_quat_w_data
        if isinstance(root_quat_w_data, torch.Tensor)
        else wp.to_torch(root_quat_w_data)
    )

    rear_left_vel_w = body_lin_vel_w[:, rear_left_id, :]
    rear_right_vel_w = body_lin_vel_w[:, rear_right_id, :]

    rear_left_vel_b = math_utils.quat_apply_inverse(
        root_quat_w,
        rear_left_vel_w,
    )

    rear_right_vel_b = math_utils.quat_apply_inverse(
        root_quat_w,
        rear_right_vel_w,
    )

    rear_left_xz_speed = torch.linalg.norm(
        rear_left_vel_b[:, [0, 2]],
        dim=-1,
    )

    rear_right_xz_speed = torch.linalg.norm(
        rear_right_vel_b[:, [0, 2]],
        dim=-1,
    )

    return torch.square(rear_left_xz_speed - rear_right_xz_speed)




def rear_left_front_right_leg_diagonal_penalty(
    env,
    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
) -> torch.Tensor:
    """Penalize rear-left leg joint being out of sync with front-right leg.

    This tests diagonal gait coordination:
    rear-left leg should behave more like the front-right diagonal partner.
    """

    asset = env.scene[asset_cfg.name]
    joint_names = list(asset.data.joint_names)

    rear_left_name = "rear_left_leg"
    front_right_name = "front_right_leg"

    if rear_left_name not in joint_names:
        raise RuntimeError(f"{rear_left_name} not found in joint names: {joint_names}")

    if front_right_name not in joint_names:
        raise RuntimeError(f"{front_right_name} not found in joint names: {joint_names}")

    rear_left_id = joint_names.index(rear_left_name)
    front_right_id = joint_names.index(front_right_name)

    joint_pos = asset.data.joint_pos

    if not isinstance(joint_pos, torch.Tensor):
        joint_pos = wp.to_torch(joint_pos)

    rear_left_pos = joint_pos[:, rear_left_id]
    front_right_pos = joint_pos[:, front_right_id]

    return torch.square(rear_left_pos - front_right_pos)


